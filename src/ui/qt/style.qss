/* Системная палитра; локальные правила компоновки главного окна Qt.
   Диалоги используют собственный FORM_STYLE, GTK эти правила не загружает. */

#statusCard {
    border: none;
    border-right: 1px solid palette(mid);
}

#statusTitle {
    font-size: 15pt;
    font-weight: 600;
}

#statusCard[state="status-connected"] #statusTitle {
    color: palette(text);
}

#statusCard[state="status-error"] #statusTitle,
#statusCard[state="status-blocked"] #statusTitle {
    color: #d13438;
}

#pendingBanner {
    background: palette(alternate-base);
    border-radius: 6px;
}

#toast {
    background: palette(tool-tip-base);
    border: 1px solid palette(mid);
    border-radius: 6px;
}

#monolithButton { background: transparent; border: 2px solid transparent; border-radius: 16px; padding: 0; }
#monolithButton:hover { background: palette(alternate-base); border-color: palette(mid); }
#monolithButton:focus { border-color: palette(highlight); }
#monolithButton:pressed { background: palette(midlight); }
#monolithButton:disabled { border-color: transparent; }
#healthSummary, #statusMode { color: palette(text); }
#healthSummary { padding: 2px 0; }
#monitoringPanel { background: palette(base); border: 1px solid palette(mid); border-radius: 10px; }
#brandLabel { font-size: 12pt; font-weight: 600; }
#statusCard QToolButton { padding: 6px 8px; }
#monitoringToggle:checked {
    background: palette(alternate-base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
}
#profileContainer QTreeView { border: 1px solid palette(mid); border-radius: 6px; }
#profileContainer { background: palette(base); border: 1px solid palette(mid); border-radius: 10px; }
#profileContainer QTreeView { border: none; border-radius: 0; }
#profileContainer QTreeView::item { padding: 6px 4px; }
#profileContainer QTreeView::item:selected { background: palette(highlight); color: palette(highlighted-text); }
#profileContainer QHeaderView::section { padding: 7px 4px; }
#profileContainer QLineEdit { min-height: 26px; padding: 3px 8px; }
#profileContainer QToolButton { min-height: 26px; padding: 3px 8px; }

#metricValue { font-size: 12pt; font-weight: 600; }
#metricCaption, #statusMode { color: palette(placeholder-text); }

#brandLabel { font-size: 19pt; font-weight: 600; }
#profileContainer QTreeView::item { padding: 0; }
#profileContainer QTreeView::item:focus { border: none; }
#connectionInstruction { color: palette(placeholder-text); }
#statusCard #statusTitle { padding: 8px 0; }
#statusCard #statusMode { padding: 8px 0; }
#statusCard #healthSummary { padding: 16px 0; }

/* Shared typography and restrained connection-state accents. */
QMainWindow QWidget { font-size: 11pt; }
QPushButton, QToolButton { min-height: 28px; padding: 4px 10px; }
#statusTitle { font-size: 20pt; }
#metricValue { font-size: 15pt; color: #36c9b5; }
#serverCaption { color: palette(placeholder-text); padding-top: 10px; }
#statusCard #statusMode { border-top: 1px solid palette(mid); padding: 12px 0; }
#statusCard #healthSummary { border-top: 1px solid palette(mid); }
#connectionDot { color: #8a969d; font-size: 17pt; }
#statusCard[state="status-connected"] #connectionDot { color: #36c9b5; }
#statusCard[state="status-connecting"] #connectionDot,
#statusCard[state="status-disconnecting"] #connectionDot { color: #ffa64d; }
#statusCard[state="status-error"] #connectionDot,
#statusCard[state="status-blocked"] #connectionDot { color: #e07078; }

#profileContainer QTreeView::branch:selected { background: palette(base); }


#monitoringPanel QGroupBox {
    border: 1px solid palette(mid);
    border-radius: 8px;
    margin-top: 20px;
    padding: 10px;
}
#monitoringPanel QGroupBox::title { subcontrol-origin: margin; padding: 0 4px; }
