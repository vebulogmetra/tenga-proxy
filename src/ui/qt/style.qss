/* Системная палитра; локальные правила компоновки главного окна Qt.
   Диалоги используют собственный FORM_STYLE, GTK эти правила не загружает. */

#statusCard {
    border: 1px solid palette(mid);
    border-radius: 8px;
}

#statusTitle {
    font-size: 15pt;
    font-weight: 600;
}

#statusCard[state="status-connected"] #statusTitle {
    color: #2e9d58;
}

#statusCard[state="status-error"] #statusTitle {
    color: #d13438;
}

#pendingBanner {
    background: palette(alternate-base);
    border-radius: 6px;
}

#toast {
    background: palette(tool-tip-base);
    border: 1px solid palette(mid);
    border-radius: 6px;
}

#monolithButton { background: transparent; border: 2px solid transparent; border-radius: 16px; padding: 0; }
#monolithButton:hover { background: palette(alternate-base); border-color: palette(mid); }
#monolithButton:focus { border-color: palette(highlight); }
#monolithButton:pressed { background: palette(midlight); }
#monolithButton:disabled { border-color: transparent; }
#healthSummary, #statusMode { color: palette(text); }
#healthSummary { padding: 2px 0; }
#monitoringPanel { border-top: 1px solid palette(mid); }
#brandLabel { font-size: 12pt; font-weight: 600; }
#statusCard QToolButton { padding: 6px 8px; }
#monitoringToggle:checked {
    background: palette(alternate-base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
}
QTreeView { border: 1px solid palette(mid); border-radius: 6px; }
#profileContainer { background: palette(base); border: 1px solid palette(mid); border-radius: 10px; }
#profileContainer QTreeView { border: none; border-radius: 0; }
QTreeView::item { padding: 6px 4px; }
QTreeView::item:selected { background: palette(highlight); color: palette(highlighted-text); }
QHeaderView::section { padding: 7px 4px; }
QLineEdit { min-height: 26px; padding: 3px 8px; }
QToolButton { min-height: 26px; padding: 3px 8px; }

#metricValue { font-size: 12pt; font-weight: 600; }
#metricCaption, #statusMode { color: palette(placeholder-text); }
