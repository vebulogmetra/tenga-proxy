# Veblock: администраторы переключают маршрут по умолчанию в режиме TUN и
# ставят таблицу nftables без пароля. Помощник принимает только apply, restore,
# dns, features, firewall-apply и firewall-remove и сам проверяет аргументы:
# имена интерфейсов, адреса и метрику. Готовых правил он не принимает.
%sudo ALL=(root) NOPASSWD: /usr/libexec/tenga-proxy/tun-route-helper
